{
  "name": "logic-architecture-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "core": "cargo run -p studio-service --bin logic-service",
    "mcp": "cargo run -q -p studio-service --bin logic-mcp",
    "test": "cargo test -p design-core -p studio-service",
    "check": "npm run build && cargo test -p design-core -p studio-service",
    "bundle": "tauri build --features custom-protocol",
    "format": "prettier --write src tokens.css vite.config.ts && cargo fmt --all",
    "test:sync": "node --experimental-strip-types --test tests/web-sync.test.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  }
}
